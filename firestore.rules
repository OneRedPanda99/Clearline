rules_version = '2';
// Clearline static HTML app — publish in Firebase Console → Firestore → Rules
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Hardcoded Owner uid. NOT a credential — it already ships to the
    // browser in config.js (CL_SECRETS.ownerUid). Hardcoding keeps a
    // document read out of the rules (the whole point of the accessUids
    // design) and guarantees a bad accessUids write can never lock the
    // Owner out of their own data.
    function ownerUid() { return "AXgm6IWBiYfbmJWsgI9b5LaLggF3"; }

    function userRef() { return /databases/$(db)/documents/users/$(uid()); }
    function hasUserDoc() { return signedIn() && exists(userRef()); }
    function userDoc() { return get(userRef()); }

    function role() {
      return hasUserDoc() && userDoc().data.role is string ? userDoc().data.role : "worker";
    }

    function perms() {
      return hasUserDoc() && userDoc().data.permissions is map ? userDoc().data.permissions : {};
    }

    // perm() is the single source of capability truth. Roles (owner/
    // manager/worker/intern) drive READ SCOPE; the per-user boolean flags
    // in users/{uid}.permissions drive what someone may WRITE. Interns are
    // "workers" for data access — what they can do stays on the flags the
    // Owner ticks per person (no second capability list in the rules).
    function perm(flag) { return isOwner() || (perms()[flag] == true); }

    function isOwner() { return signedIn() && uid() == ownerUid(); }
    function isManager() { return signedIn() && role() == "manager"; }
    // Crew = workers OR interns (both read jobs via accessUids; the
    // exact-match "worker" trap is avoided by grouping them here).
    function isCrew() { return signedIn() && (role() == "worker" || role() == "intern"); }

    // Owner provisions workers/managers/interns from manager-panel
    function ownerProvisioningUser() {
      return isOwner()
        && request.resource.data.createdBy == uid()
        && request.resource.data.role is string
        && request.resource.data.role in ["manager", "worker", "intern"];
    }

    // Privileged fields on a user doc that must never be changed by the
    // account holder themselves (only the Owner may grant/revoke roles and
    // permissions). Comparing request vs resource covers merge-writes.
    function roleUnchanged()   { return request.resource.data.role == resource.data.role; }
    function permsUnchanged()  { return request.resource.data.permissions == resource.data.permissions; }
    function mgrUnchanged()    { return request.resource.data.assignedManager == resource.data.assignedManager; }
    function activeUnchanged() { return request.resource.data.active == resource.data.active; }

    // ── users/{uid} ─────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isOwner() || isManager());
      allow create: if signedIn() && (uid() == userId || ownerProvisioningUser());

      allow update: if isOwner()
        || (uid() == userId
            && roleUnchanged() && permsUnchanged() && mgrUnchanged() && activeUnchanged())
        || (isManager()
            && resource.data.assignedManager == uid()
            && roleUnchanged() && permsUnchanged() && mgrUnchanged());

      allow delete: if isOwner();
    }

    // ── settings/global ─────────────────────────
    match /settings/global {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // ── customers/{id} ──────────────────────────
    match /customers/{id} {
      allow read: if signedIn();

      allow create: if isOwner()
        || (signedIn()
            && perm("canCreateCustomers")
            && request.resource.data.createdBy == uid());

      allow update: if isOwner()
        || (perm("canEditOwnCustomers")
            && resource.data.createdBy == uid()
            && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isOwner();
    }

    // ── jobs/{id} ───────────────────────────────
    // CRITICAL RULES/QUERY CONTRACT:
    // Firestore security rules are NOT filters. A query is rejected
    // outright (permission-denied) if it *could* return a document the
    // rule doesn't grant — and the rule is evaluated against the query's
    // POTENTIAL result set, not the actual documents. Any get()/exists()
    // call (like reading the caller's own user doc for their role) cannot
    // be proven per-document, so a get() inside a LIST rule fails the whole
    // query for non-owner roles. (Empirically confirmed on this project
    // 2026-07-25: an isOwner() branch in the jobs LIST rule denied worker
    // filtered array-contains queries.)
    //
    // SOLUTION: each job carries an accessUids array (denormalized at write
    // time) listing every uid allowed to read it — owner + creator +
    // assigned manager + every crew worker. The list rule
    // `uid() in resource.data.accessUids` is fully provable from the query's
    // own where('accessUids','array-contains',uid) clause. NO get(). The
    // Owner reads all jobs because the backfill stamps the Owner uid into
    // every job's accessUids.
    function isAssignedWorker() {
      return (resource.data.assignedWorkers is list && uid() in resource.data.assignedWorkers)
        || resource.data.assignedTo == uid();
    }

    // A non-owner write may change crew in BOTH directions (add or remove a
    // worker), but the new accessUids must:
    //   - always contain the Owner uid,
    //   - always contain the job's creator and assigned manager,
    //   - be a superset of the new crew (assignedWorkers),
    //   - contain ONLY those uids (no stray readers added).
    // This lets a manager shrink accessUids when removing a worker while
    // still preventing anyone from locking out the Owner/creator/manager.
    // Managers granted `canViewAllJobs` are readers of EVERY job. A list
    // rule can't call get(), so the only way to widen a query is the
    // accessUids array itself — their uids are mirrored into
    // settings/global.globalViewerUids and stamped onto every job by the
    // client. Reading that doc here is fine: this helper is only used by
    // update rules, never by a list rule.
    function globalViewers() {
      return exists(/databases/$(db)/documents/settings/global)
        && get(/databases/$(db)/documents/settings/global).data.globalViewerUids is list
        ? get(/databases/$(db)/documents/settings/global).data.globalViewerUids
        : [];
    }

    // A job may name several managers. `assignedManagers` (list) is the
    // source of truth; `assignedManager` (string) is kept in step as the
    // first entry for older clients and the rules below.
    function newManagers() {
      return request.resource.data.assignedManagers is list
        ? request.resource.data.assignedManagers
        : (request.resource.data.assignedManager == null ? [] : [request.resource.data.assignedManager]);
    }
    function oldManagers() {
      return resource.data.assignedManagers is list
        ? resource.data.assignedManagers
        : (resource.data.assignedManager == null ? [] : [resource.data.assignedManager]);
    }
    function isAssignedManager() {
      return isManager() && uid() in oldManagers();
    }

    function accessUidsConsistent() {
      return request.resource.data.accessUids is list
        && request.resource.data.accessUids.hasAll([ownerUid()])
        && (resource.data.createdBy == null
            || request.resource.data.accessUids.hasAll([resource.data.createdBy]))
        && request.resource.data.accessUids.hasAll(oldManagers())
        && (request.resource.data.assignedWorkers is list
            ? request.resource.data.accessUids.hasAll(request.resource.data.assignedWorkers)
            : true)
        && request.resource.data.accessUids.removeAll(
             [ownerUid()]
               .concat(resource.data.createdBy == null ? [] : [resource.data.createdBy])
               .concat(oldManagers())
               .concat(newManagers())
               .concat(request.resource.data.assignedWorkers is list ? request.resource.data.assignedWorkers : [])
               .concat(globalViewers())
           ).size() == 0;
    }

    match /jobs/{id} {
      // get: single doc. Allowed if accessUids grants the caller, or they
      // created it, or they are its assigned manager. (Legacy
      // assignedWorkers/assignedTo fallbacks dropped — backfill ran.)
      allow get: if signedIn()
        && (isOwner()
            || resource.data.accessUids is list && uid() in resource.data.accessUids
            || resource.data.createdBy == uid()
            || isAssignedManager());

      // list: PROVABLE from the client's where('accessUids','array-contains',
      // uid) query. NO get(). The `is list` type-check is intentionally
      // ABSENT here: the static query validator cannot prove the field is a
      // list from the array-contains clause, so including it rejects every
      // filtered query as "unprovable" (permission-denied) even with correct
      // data. array-contains already guarantees the field is a list at query
      // time. Type-safety is enforced in create/update/get instead.
      // The Owner gets a read-free escape hatch (uid() == ownerUid() is a
      // constant comparison, provable without a document read) so the
      // backfill/repair tool can list every job — including any job that
      // lost its accessUids and would otherwise be invisible to everyone.
      allow list: if signedIn()
        && (uid() in resource.data.accessUids || uid() == ownerUid());

      // create: Owner may create any job; others must stamp accessUids
      // including themselves + owner.
      allow create: if isOwner()
        || (signedIn()
            && perm("canCreateJobs")
            && request.resource.data.createdBy == uid()
            && request.resource.data.accessUids is list
            && uid() in request.resource.data.accessUids
            && ownerUid() in request.resource.data.accessUids);

      // update: Owner may do anything. Non-owners may edit a job they are
      // on, but only if accessUids stays consistent (see above). Managers
      // may edit jobs they manage; crew (workers + interns) may edit jobs
      // they created or are assigned to. No canEditOwnJobs flag is required
      // for either — that flag is only a local default and was never written
      // to Firestore, so requiring it just reproduced Xavier's denial for
      // managers. accessUidsConsistent() is the real guard.
      allow update: if isOwner()
        || (accessUidsConsistent()
            && request.resource.data.createdBy == resource.data.createdBy
            && (isAssignedManager()
                || (isCrew()
                  && (resource.data.createdBy == uid() || isAssignedWorker()))));

      // Lightweight update: a write that does NOT change access/crew/owner
      // fields (e.g. Confirm assignment, status, notes) is allowed for
      // anyone already on the job, without re-proving accessUidsConsistent().
      // This is what powers worker "Confirm assignment": the worker is in
      // the job's accessUids (so they can read it) but a diverged/legacy
      // assignedWorkers or a stale extra accessUids entry would otherwise
      // fail the strict branch above. Requiring every access field to be
      // UNCHANGED prevents this line from ever widening read access.
      allow update: if signedIn()
        && request.resource.data.accessUids == resource.data.accessUids
        && request.resource.data.assignedWorkers == resource.data.assignedWorkers
        && request.resource.data.assignedManager == resource.data.assignedManager
        && newManagers() == oldManagers()
        && request.resource.data.createdBy == resource.data.createdBy
        && (isAssignedManager()
            || (isCrew() && (resource.data.createdBy == uid() || uid() in resource.data.accessUids)));

      allow delete: if isOwner();
    }

    // ── estimates/{id} ──────────────────────────
    match /estimates/{id} {
      function jobSnap(jobId) { return get(/databases/$(db)/documents/jobs/$(jobId)); }

      function estLinkedToMyTeam() {
        return (resource.data.jobId is string)
          && exists(/databases/$(db)/documents/jobs/$(resource.data.jobId))
          && jobSnap(resource.data.jobId).data.assignedManager == uid();
      }

      function estCreatorIsMyWorker() {
        return !(resource.data.jobId is string)
          && (resource.data.createdBy is string)
          && exists(/databases/$(db)/documents/users/$(resource.data.createdBy))
          && get(/databases/$(db)/documents/users/$(resource.data.createdBy)).data.assignedManager == uid();
      }

      // LIST: provable from the query's own where() fields only (no get()).
      allow list: if signedIn()
        && (resource.data.userId == uid() || resource.data.createdBy == uid());

      // GET: single-doc fetch may use the get()-based manager/owner branches.
      allow get: if signedIn()
        && (resource.data.userId == uid()
            || resource.data.createdBy == uid()
            || isOwner()
            || (isManager() && (estLinkedToMyTeam() || estCreatorIsMyWorker())));

      allow create: if signedIn()
        && perm("canUseEstimateForm")
        && request.resource.data.createdBy == uid();

      allow update: if isOwner()
        || resource.data.createdBy == uid()
        || (isManager() && perm("canUseEstimateForm") && (estLinkedToMyTeam() || estCreatorIsMyWorker()));

      allow delete: if isOwner();
    }

    // ── invoices/{id} ───────────────────────────
    match /invoices/{id} {
      allow list: if signedIn()
        && (resource.data.userId == uid() || resource.data.createdBy == uid());

      allow get: if signedIn()
        && (resource.data.userId == uid()
            || resource.data.createdBy == uid()
            || isOwner());

      allow create: if signedIn()
        && perm("canUseEstimateForm")
        && request.resource.data.createdBy == uid();

      allow update: if isOwner()
        || resource.data.createdBy == uid()
        || resource.data.userId == uid();

      allow delete: if isOwner();
    }

    // ── expenses / payroll (Money page, owner-only) ──
    match /expenses/{id} { allow read, write: if isOwner(); }
    match /payroll/{id} { allow read, write: if isOwner(); }

    // ── activityLog/{id} (immutable audit trail, Owner-only viewing) ──
    match /activityLog/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && request.resource.data.actorUid == uid();
      allow update, delete: if false;
    }
  }
}
